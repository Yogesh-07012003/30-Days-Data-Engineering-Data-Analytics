import pandas as pd


# Read CSV
df = pd.read_csv("employees.csv")


# Display complete dataset
print("Complete Dataset:")
print(df)


# First 5 rows
print("\nFirst 5 Rows:")
print(df.head())


# Dataset information
print("\nDataset Information:")
df.info()


# Statistical summary
print("\nStatistical Summary:")
print(df.describe())


# Dataset shape
print("\nDataset Shape:")
print(df.shape)


# Number of rows
print("\nNumber of Rows:")
print(df.shape[0])


# Number of columns
print("\nNumber of Columns:")
print(df.shape[1])


# Column names
print("\nColumn Names:")
print(df.columns.tolist())


# Average salary
print("\nAverage Salary:")
print(df["salary"].mean())


# Highest salary
print("\nHighest Salary:")
print(df["salary"].max())


# Lowest salary
print("\nLowest Salary:")
print(df["salary"].min())


# Average experience
print("\nAverage Experience:")
print(df["experience"].mean())


# Chennai employees
print("\nChennai Employees:")
print(df[df["city"] == "Chennai"])


# Data Engineering employees
print("\nData Engineering Employees:")
print(df[df["department"] == "Data Engineering"])
