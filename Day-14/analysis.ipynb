
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# =====================================================
# 1. LOAD DATASET
# =====================================================

df = pd.read_csv("dataset.csv")

df["order_date"] = pd.to_datetime(df["order_date"])

print("First five rows:")
display(df.head())

print("\nDataset shape:")
print(df.shape)

print("\nColumn names:")
print(df.columns.tolist())

print("\nDataset information:")
df.info()

print("\nStatistical summary:")
display(df.describe())


# =====================================================
# 2. MISSING VALUE ANALYSIS
# =====================================================

print("\nMissing values:")
print(df.isnull().sum())

print("\nMissing value percentage:")
print((df.isnull().mean() * 100).round(2))

sns.heatmap(df.isnull(), cbar=False, cmap="viridis")
plt.title("Missing Values")
plt.show()


# =====================================================
# 3. DATA CLEANING
# =====================================================

clean_df = df.copy()

# Convert numeric columns safely
clean_df["quantity"] = pd.to_numeric(
    clean_df["quantity"], errors="coerce"
)

clean_df["sales"] = pd.to_numeric(
    clean_df["sales"], errors="coerce"
)

# Fill missing category
clean_df["category"] = clean_df["category"].fillna("Unknown")

# Fill missing quantity using the median
clean_df["quantity"] = clean_df["quantity"].fillna(
    clean_df["quantity"].median()
)

# Recalculate missing sales using quantity * unit price
missing_sales = clean_df["sales"].isna()

clean_df.loc[missing_sales, "sales"] = (
    clean_df.loc[missing_sales, "quantity"]
    * clean_df.loc[missing_sales, "unit_price"]
)

print("\nMissing values after cleaning:")
print(clean_df.isnull().sum())


# =====================================================
# 4. OUTLIER DETECTION USING IQR
# =====================================================

Q1 = clean_df["sales"].quantile(0.25)
Q3 = clean_df["sales"].quantile(0.75)

IQR = Q3 - Q1

lower_limit = Q1 - 1.5 * IQR
upper_limit = Q3 + 1.5 * IQR

outliers = clean_df[
    (clean_df["sales"] < lower_limit)
    | (clean_df["sales"] > upper_limit)
]

print("\nPotential outliers:")
display(outliers)

sns.boxplot(x=clean_df["sales"])
plt.title("Sales Outlier Detection")
plt.show()


# =====================================================
# 5. MONTHLY SALES TREND
# =====================================================

monthly_sales = (
    clean_df.set_index("order_date")["sales"]
    .resample("MS")
    .sum()
)

print("\nMonthly sales:")
display(monthly_sales)

monthly_sales.plot(
    kind="line",
    marker="o",
    figsize=(10, 5)
)

plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Total Sales")
plt.grid(True)
plt.show()


# =====================================================
# 6. CATEGORY ANALYSIS
# =====================================================

category_sales = clean_df.groupby(
    "category"
)["sales"].sum().sort_values(ascending=False)

print("\nSales by category:")
display(category_sales)

category_sales.plot(kind="bar", figsize=(8, 5))
plt.title("Sales by Category")
plt.xlabel("Category")
plt.ylabel("Total Sales")
plt.xticks(rotation=30)
plt.show()


# =====================================================
# 7. REGIONAL ANALYSIS
# =====================================================

region_sales = clean_df.groupby(
    "region"
)["sales"].sum().sort_values(ascending=False)

print("\nSales by region:")
display(region_sales)

region_sales.plot(kind="bar", figsize=(8, 5))
plt.title("Sales by Region")
plt.xlabel("Region")
plt.ylabel("Total Sales")
plt.show()


# =====================================================
# 8. PRODUCT ANALYSIS
# =====================================================

product_sales = clean_df.groupby(
    "product"
)["sales"].sum().sort_values(ascending=False)

print("\nRevenue by product:")
display(product_sales)

product_quantity = clean_df.groupby(
    "product"
)["quantity"].sum().sort_values(ascending=False)

print("\nQuantity sold by product:")
display(product_quantity)


# =====================================================
# 9. CORRELATION ANALYSIS
# =====================================================

numeric_df = clean_df[
    ["quantity", "unit_price", "sales"]
]

correlation = numeric_df.corr()

print("\nCorrelation matrix:")
display(correlation)

sns.heatmap(
    correlation,
    annot=True,
    cmap="coolwarm",
    vmin=-1,
    vmax=1
)

plt.title("Sales Correlation Heatmap")
plt.show()


# =====================================================
# 10. DISTRIBUTION ANALYSIS
# =====================================================

sns.histplot(
    data=clean_df,
    x="sales",
    bins=10,
    kde=True
)

plt.title("Sales Distribution")
plt.xlabel("Sales Amount")
plt.show()

sns.histplot(
    data=clean_df,
    x="quantity",
    bins=10,
    kde=True
)

plt.title("Quantity Distribution")
plt.xlabel("Quantity Sold")
plt.show()

sns.boxplot(
    data=clean_df,
    x="category",
    y="sales"
)

plt.title("Sales Distribution by Category")
plt.xticks(rotation=30)
plt.show()


# =====================================================
# 11. BUSINESS SUMMARY
# =====================================================

print("\n========== EDA SUMMARY ==========")

print("Total orders:", len(clean_df))
print("Total revenue:", clean_df["sales"].sum())

print(
    "Average sales per order:",
    round(clean_df["sales"].mean(), 2)
)

print(
    "Top product by quantity:",
    product_quantity.idxmax()
)

print(
    "Highest revenue category:",
    category_sales.idxmax()
)

print(
    "Highest revenue region:",
    region_sales.idxmax()
)

print("Potential outlier count:", len(outliers))


# =====================================================
# 12. SAVE CLEANED DATASET
# =====================================================

clean_df.to_csv("cleaned_dataset.csv", index=False)

print("\nCleaned dataset saved successfully!")
print("Day 14 EDA project completed.")
```
