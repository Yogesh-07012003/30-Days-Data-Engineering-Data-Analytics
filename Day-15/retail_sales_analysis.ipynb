# Day 15: Retail Sales Analysis
# Tools: Python, Pandas, Matplotlib

import pandas as pd
import matplotlib.pyplot as plt

1. Load the dataset
df = pd.read_csv("retail_sales.csv")

2. Inspect the dataset
print("First 5 rows:")
print(df.head())

print("\nDataset shape:", df.shape)
print("\nColumn information:")
df.info()

print("\nMissing values:")
print(df.isnull().sum())

# 3. Prepare the data
df["order_date"] = pd.to_datetime(df["order_date"], errors="coerce")

numeric_columns = [
    "quantity", "unit_price", "cost_price"
]

for column in numeric_columns:
    df[column] = pd.to_numeric(df[column], errors="coerce")

df = df.dropna(
    subset=[
        "order_date", "order_id", "customer_id",
        "product", "quantity", "unit_price", "cost_price"
    ]
).copy()

# 4. Calculate revenue, cost, and profit
df["revenue"] = df["quantity"] * df["unit_price"]
df["total_cost"] = df["quantity"] * df["cost_price"]
df["profit"] = df["revenue"] - df["total_cost"]

print("\nCleaned data:")
print(df.head())

# 5. Calculate business KPIs
total_revenue = df["revenue"].sum()
total_cost = df["total_cost"].sum()
total_profit = df["profit"].sum()
total_orders = df["order_id"].nunique()
total_customers = df["customer_id"].nunique()
total_products = df["product"].nunique()

profit_margin = (
    total_profit / total_revenue * 100
    if total_revenue != 0 else 0
)

print("\n========== RETAIL SALES SUMMARY ==========")
print(f"Total Revenue: ₹{total_revenue:,.2f}")
print(f"Total Cost: ₹{total_cost:,.2f}")
print(f"Total Profit: ₹{total_profit:,.2f}")
print(f"Profit Margin: {profit_margin:.2f}%")
print(f"Total Orders: {total_orders}")
print(f"Total Customers: {total_customers}")
print(f"Unique Products: {total_products}")

# 6. Revenue and profit by product
product_analysis = (
    df.groupby("product")
    .agg(
        revenue=("revenue", "sum"),
        profit=("profit", "sum"),
        quantity_sold=("quantity", "sum")
    )
    .sort_values("revenue", ascending=False)
)

print("\nRevenue and profit by product:")
print(product_analysis)

# Best-performing product by revenue
print("\nTop product by revenue:")
print(product_analysis["revenue"].idxmax())

# 7. Customer analysis
customer_analysis = (
    df.groupby(["customer_id", "customer_name"])
    .agg(
        total_spending=("revenue", "sum"),
        total_orders=("order_id", "nunique")
    )
    .sort_values("total_spending", ascending=False)
)

print("\nCustomer analysis:")
print(customer_analysis)

print("\nTop customer:")
print(customer_analysis.index[0])

# 8. Regional analysis
region_analysis = (
    df.groupby("region")
    .agg(
        revenue=("revenue", "sum"),
        profit=("profit", "sum"),
        orders=("order_id", "nunique")
    )
    .sort_values("revenue", ascending=False)
)

print("\nRegional analysis:")
print(region_analysis)

# 9. Category analysis
category_analysis = (
    df.groupby("category")
    .agg(
        revenue=("revenue", "sum"),
        profit=("profit", "sum"),
        quantity_sold=("quantity", "sum")
    )
    .sort_values("revenue", ascending=False)
)

print("\nCategory analysis:")
print(category_analysis)

# 10. Monthly sales trend
df["month"] = df["order_date"].dt.to_period("M").astype(str)

monthly_analysis = (
    df.groupby("month")
    .agg(
        revenue=("revenue", "sum"),
        profit=("profit", "sum")
    )
    .sort_index()
)

print("\nMonthly sales analysis:")
print(monthly_analysis)

# 11. Chart 1: Monthly revenue trend
plt.figure(figsize=(10, 5))
plt.plot(
    monthly_analysis.index,
    monthly_analysis["revenue"],
    marker="o"
)
plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue (₹)")
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()

# 12. Chart 2: Revenue by region
plt.figure(figsize=(8, 5))
region_analysis["revenue"].plot(kind="bar")
plt.title("Revenue by Region")
plt.xlabel("Region")
plt.ylabel("Revenue (₹)")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# 13. Chart 3: Revenue by product
plt.figure(figsize=(9, 5))
product_analysis["revenue"].sort_values().plot(kind="barh")
plt.title("Revenue by Product")
plt.xlabel("Revenue (₹)")
plt.ylabel("Product")
plt.tight_layout()
plt.show()

# 14. Chart 4: Profit by category
plt.figure(figsize=(8, 5))
category_analysis["profit"].plot(kind="bar")
plt.title("Profit by Product Category")
plt.xlabel("Category")
plt.ylabel("Profit (₹)")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# 15. Chart 5: Top 5 customers by spending
top_customers = customer_analysis.head(5)

plt.figure(figsize=(9, 5))
top_customers["total_spending"].sort_values().plot(kind="barh")
plt.title("Top 5 Customers by Spending")
plt.xlabel("Total Spending (₹)")
plt.ylabel("Customer")
plt.tight_layout()
plt.show()

# 16. Chart 6: Revenue share by category
plt.figure(figsize=(7, 7))
category_analysis["revenue"].plot(
    kind="pie",
    autopct="%1.1f%%",
    startangle=90
)
plt.title("Revenue Share by Category")
plt.ylabel("")
plt.tight_layout()
plt.show()

# 17. Export the analyzed dataset
df.to_csv("retail_sales_analyzed.csv", index=False)

print("\nAnalyzed dataset saved as retail_sales_analyzed.csv")
print("Retail Sales Analysis completed successfully!")
